<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The accounts Karpo reads by itself: a Microsoft account over Graph, a Google
    account over Google's APIs, a mail server over IMAP, and a CalDAV/CardDAV
    server. The dock reads calendars, contacts and mail through it, and signs in
    and finds servers through it. Nothing here draws anything, and every request
    is a read but the tasks': a task ticked, added, renamed or deleted
    (Microsoft\MicrosoftTodo.cs, Google\GoogleTasks.cs).

    No UI types (no WinRT, no WinUI), so both apps can reference it, and it is
    native-AOT clean: JSON goes through JsonNode or a generated context, never
    the reflecting serializer.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Karpo.Accounts</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MailKit" Version="4.18.0" />
    <!-- MimeKit still pins Pkcs 10.0.0 (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7);
         lift it to the patched release until MimeKit does. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
    <ProjectReference Include="..\Karpo.Core\Karpo.Core.csproj" />
  </ItemGroup>
  <!--
    Google's client secret (Google\GoogleAuth.cs, docs\widgets.md §713) is not in the source: a build takes it from
    the property KarpoGoogleClientSecret, which Local.Build.props sets on the PC Karpo is made on (the file is not in
    the repository) and the environment's KARPO_GOOGLE_CLIENT_SECRET sets in the release workflow. Without either
    the build has none and offers no Google account; everything else is the same. §716: KarpoGoogleSignIn=false
    (scripts\publish.ps1 -WithoutGoogle) leaves it out of a build that would have had it.
  -->
  <PropertyGroup Condition="'$(KarpoGoogleClientSecret)' == ''">
    <KarpoGoogleClientSecret>$(KARPO_GOOGLE_CLIENT_SECRET)</KarpoGoogleClientSecret>
  </PropertyGroup>
  <ItemGroup Condition="'$(KarpoGoogleClientSecret)' != '' and '$(KarpoGoogleSignIn)' != 'false'">
    <AssemblyMetadata Include="KarpoGoogleClientSecret" Value="$(KarpoGoogleClientSecret)" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Karpo.Tests" />
  </ItemGroup>
</Project>
